# AI Forge environment configuration.
# Copy this file to `.env` and fill in values for the providers and services
# you want to enable. The Settings root in `forge.config.settings` reads these
# at startup. Profile-based YAML overlays in `configs/<profile>.yaml` are layered
# on top of these defaults.

# -----------------------------------------------------------------------------
# Runtime profile + diagnostics
# -----------------------------------------------------------------------------
# FORGE_PROFILE=dev
# FORGE_DIAGNOSTIC=0
# FORGE_DIAGNOSTIC_PATH=./forge-diagnostic.ndjson

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# FORGE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# FORGE_LOG_FORMAT=auto         # auto (TTY-aware) | pretty | json

# -----------------------------------------------------------------------------
# Provider credentials (filled in as Phase 1 sub-phases land)
# -----------------------------------------------------------------------------
# OpenAI
# OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Anthropic
# ANTHROPIC_API_KEY=

# Google / Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service-account JSON
# GCP_PROJECT=
# GCP_REGION=us-central1

# AWS / Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-10-01-preview

# -----------------------------------------------------------------------------
# Observability + storage (filled in as Phase 2+ sub-phases land)
# -----------------------------------------------------------------------------
# Langfuse
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Redis (response cache backend; optional via [redis] extra)
# REDIS_URL=redis://localhost:6379/0

# Qdrant (RAG vector store; lands in Phase 4)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
