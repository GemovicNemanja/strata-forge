# AI Forge environment configuration.
# Copy this file to `.env` and fill in values for the providers and services
# you want to enable. `strata_forge.config.settings.Settings` reads these at startup.
# Profile-based YAML overlays in `configs/<FORGE_PROFILE>.yaml` are layered
# underneath these values.

# -----------------------------------------------------------------------------
# Runtime profile
# -----------------------------------------------------------------------------
# Selects which YAML overlay (configs/<profile>.yaml) is layered under env vars.
# FORGE_PROFILE=dev

# -----------------------------------------------------------------------------
# Diagnostic NDJSON dump
# -----------------------------------------------------------------------------
# When ENABLED is true (1, true, yes), every completed LLM call appends to PATH.
# FORGE_DIAGNOSTIC_ENABLED=false
# FORGE_DIAGNOSTIC_PATH=./forge-diagnostic.ndjson

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# FORGE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
# FORGE_LOG_FORMAT=auto         # auto (TTY-aware) | pretty | json

# -----------------------------------------------------------------------------
# Storage gateway (Phase 6)
# -----------------------------------------------------------------------------
# FORGE_STORAGE_DEFAULT_BACKEND=local   # local | s3 | gcs | azure | hf

# -----------------------------------------------------------------------------
# Langfuse observability (Phase 2)
# -----------------------------------------------------------------------------
# Tracing activates only when BOTH keys are present.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Redis (response cache backend; opt-in via the [redis] extra)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Qdrant (RAG vector store; Phase 4)
# -----------------------------------------------------------------------------
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# LLM provider credentials (Phase 1 — uncomment as providers land)
# -----------------------------------------------------------------------------
# OpenAI
# OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Anthropic
# ANTHROPIC_API_KEY=

# Google / Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service-account JSON
# GCP_PROJECT=
# GCP_REGION=us-central1

# AWS / Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-10-01-preview
