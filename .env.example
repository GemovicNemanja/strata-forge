# strata-forge environment configuration.
# Copy this file to `.env` and fill in values for the providers and services
# you want to enable.
#
# `strata_forge.config.Settings` reads the `FORGE_*`, `LANGFUSE_*`, `REDIS_*`,
# `QDRANT_*` and `HF_*` values from the process environment or from a `.env` in
# the working directory, the first time `get_settings()` is called. Provider
# credentials are read from the process environment by the models in
# `strata_forge.llm.providers.config`; LiteLLM also loads a discoverable `.env`
# of its own when it is imported.
#
# `strata-forge doctor` prints the resolved profile, logging, diagnostic and
# storage values plus a reachability probe for Langfuse, Redis and Qdrant, so it
# is the quickest way to check that those landed where you expected.

# -----------------------------------------------------------------------------
# Runtime profile
# -----------------------------------------------------------------------------
# Free-form label recorded on `settings.profile` and shown by `strata-forge
# doctor`. Use it to tell environments apart in your own bootstrap code.
# FORGE_PROFILE=dev

# -----------------------------------------------------------------------------
# Diagnostic NDJSON dump
# -----------------------------------------------------------------------------
# When ENABLED is true (1, true, yes), every completed LLM call appends to PATH.
# FORGE_DIAGNOSTIC_ENABLED=false
# FORGE_DIAGNOSTIC_PATH=./forge-diagnostic.ndjson

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Read into `settings.logging`; apply them by passing the values to
# `strata_forge.core.configure_logging()` from your own entry point.
# FORGE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
# FORGE_LOG_FORMAT=auto         # auto (TTY-aware) | pretty | json

# -----------------------------------------------------------------------------
# Storage gateway
# -----------------------------------------------------------------------------
# Recorded on `settings.storage` and shown by `strata-forge doctor`.
# `StorageGateway` itself picks the filesystem from each URL's scheme, so this
# is a label for your own code rather than a switch inside the gateway.
# FORGE_STORAGE_DEFAULT_BACKEND=local   # local | s3 | gcs | azure | hf

# -----------------------------------------------------------------------------
# Hugging Face Hub
# -----------------------------------------------------------------------------
# `HFHubClient` falls back to these when constructed without an explicit
# token / endpoint. `huggingface_hub` reads the same two names natively.
# HF_TOKEN=
# HF_ENDPOINT=https://huggingface.co

# -----------------------------------------------------------------------------
# Langfuse observability
# -----------------------------------------------------------------------------
# Tracing activates only when BOTH keys are present. The Langfuse-backed prompt
# and dataset stores read the same three variables.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Environment label stamped on every trace so deployments stay separable in the
# Langfuse UI. Unset leaves the SDK on its built-in "default" environment.
# LANGFUSE_TRACING_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Redis (response cache backend; opt-in via the [redis] extra)
# -----------------------------------------------------------------------------
# Populates `settings.redis.url`, which `strata-forge doctor` probes.
# `RedisCache(url=...)` takes the URL as a constructor argument.
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Qdrant (RAG vector store)
# -----------------------------------------------------------------------------
# Populates `settings.qdrant`, which `strata-forge doctor` probes.
# `QdrantVectorStore(url=..., api_key=...)` takes them as constructor arguments.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Cohere (reranker; part of the [rag] extra)
# -----------------------------------------------------------------------------
# Read by the Cohere SDK when `CohereReranker` is built without an api_key.
# COHERE_API_KEY=

# -----------------------------------------------------------------------------
# LLM provider credentials
# -----------------------------------------------------------------------------
# OpenAI
# OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Anthropic
# ANTHROPIC_API_KEY=

# Google / Vertex AI
# GOOGLE_APPLICATION_CREDENTIALS=    # path to service-account JSON
# GCP_PROJECT=
# GCP_REGION=us-central1

# AWS / Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-10-01-preview

# OpenAI-compatible server (vLLM / TGI / SGLang you host yourself)
# FORGE_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
# FORGE_OPENAI_COMPAT_API_KEY=

# -----------------------------------------------------------------------------
# Runner variables (read directly by long-running entry points)
# -----------------------------------------------------------------------------
# Where training runners and the batch-inference runner append NDJSON progress
# events. Ignored when neither is in use.
# FORGE_PROGRESS_PATH=./forge-progress.ndjson
# JSON run spec for `python -m strata_forge.pipelines.inference_runner`; the
# runner refuses to start without it.
# STRATA_RUN_CONFIG=
# Write-scoped Hugging Face token the batch-inference runner uses to publish its
# results dataset. Without it, results stay on the machine that produced them.
# HF_WRITE_TOKEN=
